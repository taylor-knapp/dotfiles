{
  "cleanupPeriodDays": 120,
  "env": {
    "ANTHROPIC_MODEL": "claude-haiku-5-5[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-5-5",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5[1m]",
    "CAVEMAN_DEFAULT_MODE": "ultra",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "350000",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "DISABLE_BUG_COMMAND": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_TELEMETRY": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "0",
    "TICKETS_DIR": "/Users/taylorknapp/code/tickets",
    "VISUAL": "nvim",
    "MAX_THINKING_TOKENS": "0"
  },
  "permissions": {
    "deny": [
      "Bash(# === Specific MCP tool call blocks must remain here. ===)",
      "mcp__circleci__create_prompt_template",
      "mcp__circleci__recommend_prompt_template_tests",
      "mcp__circleci__run_evaluation_tests",
      "mcp__circleci__run_rollback_pipeline"
    ]
  },
  "model": "haiku",
  "disableBundledSkills": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.dotfiles/claude/hooks/caveman-ultra-reinforce.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.dotfiles/claude/hooks/set-session-title.sh"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.dotfiles/claude/hooks/worktree-create.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.dotfiles/claude/hooks/block-directory-switching.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.dotfiles/claude/hooks/fix-echo-dashes.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Response ready\" with title \"Claude Code - Finished\" sound name \"Submarine\"'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Input needed\" with title \"Claude Code - Question\" sound name \"Submarine\"'"
          }
        ]
      },
      {
        "matcher": "elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Input needed\" with title \"Claude Code - Question\" sound name \"Submarine\"'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.dotfiles/claude/scripts/statusline-command.sh"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "caveman@caveman": true,
    "ponytail@ponytail": true,
    "nono@nolabs-ai": true,
    "simple-english@simple-english": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "simple-english": {
      "source": {
        "source": "github",
        "repo": "AminBlg/SimpleEnglish"
      }
    }
  },
  "effortLevel": "low",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "low"
    },
    "claude-haiku-5-5": {
      "effortLevel": "low"
    }
  },
  "advisorModel": "opus",
  "autoMemoryEnabled": true,
  "autoMemoryDirectory": "~/.dotfiles/claude/memory",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "voiceEnabled": true
}
