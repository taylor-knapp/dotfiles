{
  "$schema": "../profile.schema.json",
  "extends": [
    "default",
    "node-dev"
  ],
  "meta": {
    "name": "agent-base",
    "description": "Essential fs + network policy for coding agents (cwd + basics; used by --directory-only)"
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "read": [
      "$HOME/.dotfiles/claude",
      "$HOME/.dotfiles/git",
      "$HOME/.certs",
      "$HOME/.local/share/fnm"
    ],
    "allow": [
      "/tmp/claude",
      "$HOME/.local/state/fnm_multishells",
      // The default profile allows read access to $HOME/.gitconfig, but we want also to allow 
      // read access to $HOME/.gitconfig.local for local overrides. 
      "$HOME/.gitconfig.local"
    ],
    // globs (**/) seem to apply, even outside the working directory.
    "deny": [ 
      { "path": "$HOME/.ssh" },
      { "path": "$HOME/.aws" },
      { "path": "$HOME/.azure" },
      { "path": "**/.git/hooks" },
      { "path": "**/.git/config" },
      { "path": "$HOME/.gnupg-claude" },
      { "path": "**/.env" },
      { "path": "**/.env.*" },
      { "path": "**/*.client.env" },
      { "path": "**/secrets/**" }
    ]
  },
  "network": {
    // Fine-grained GitHub PATs, one per resource owner. claude-nono enables one per session
    // (--credential) from the origin remote's owner. Real tokens live in Keychain (service
    // "nono", account = credential_key); the sandbox sees only a phantom GH_TOKEN.
    "custom_credentials": {
      "github_personal": {
        "upstream": "https://api.github.com",
        "credential_key": "github_personal",
        "env_var": "GH_TOKEN",
        "inject_header": "Authorization",
        "credential_format": "token {}"
      },
      "github_commercetools": {
        "upstream": "https://api.github.com",
        "credential_key": "github_commercetools",
        "env_var": "GH_TOKEN",
        "inject_header": "Authorization",
        "credential_format": "token {}"
      }
    },
    "allow_domain": [
      "api.anthropic.com",
      "claude.ai",
      "console.anthropic.com",
      "statsig.anthropic.com",
      "sentry.io",
      "claude.com",
      "code.claude.com",
      "github.com",
      "api.github.com",
      "docs.github.com",
      "api.githubcopilot.com",
      "api.enterprise.githubcopilot.com",
      "telemetry.enterprise.githubcopilot.com",
      "commercetools.com",
      "*.commercetools.com",
      "circleci.com",
      "*.circleci.com",
      "coderabbit.ai",
      "*.coderabbit.ai",
      "depot.dev",
      "*.depot.dev",
      "escemo.com",
      "*.escemo.com",
      "fly.io",
      "*.fly.io",
      "mynah.fly.dev",
      "mynah-staging.fly.dev",
      "api.machines.dev",
      "modelcontextprotocol.io",
      "*.modelcontextprotocol.io",
      "ucp.dev",
      "*.ucp.dev",
      "mcp.atlassian.com",
      "cf.mcp.atlassian.com",
      "developer.atlassian.com",
      "cloud.humio.com",
      "docs.cloud.google.com",
      "storage.googleapis.com",
      "proxy.golang.org",
      "openai.com",
      "stackoverflow.com",
      "httpwg.org",
      "www.rfc-editor.org",
      "iterm2.com",
      "ghostty.org",
      "gail.wharton.upenn.edu",
      "www.leapsome.com",
      "nono.sh",
      "*.nono.sh"
    ]
  },
  "environment": {
    "deny_vars": [
      "SSH_AUTH_SOCK",
      "GPG_AGENT_INFO"
    ],
    "set_vars": {
      "NODE_EXTRA_CA_CERTS": "$HOME/.certs/zscaler-root-ca.pem" 
    }
  },
  "rollback": {
    "exclude_patterns": [
      "node_modules",
      ".next",
      "dist",
      "build",
      "coverage",
      ".turbo",
      ".pnpm-store",
      "__pycache__",
      "target"
    ],
    "exclude_globs": [
      "*.log",
      "*.tmp.[0-9]*.[0-9]*"
    ]
  },
  "command_policies": {
    "commands": {
      // Session can't touch .git/config (filesystem.deny); mediated git can, but only
      // for allowlisted subcommands. Prefix match on argv[0] also blocks global opts
      // (-c, -C, --git-dir, --exec-path) since they precede the subcommand.
      "git": {
        "executable": "/opt/homebrew/bin/git",
        "can_use": ["gpg"],
        "from": {
          "session": {
            "sandbox": {
              "fs_read": ["/opt/homebrew", "$HOME/.config/gh", "$HOME/.gnupg-claude"],
              "fs_read_file": ["@git:config-files"],
              "fs_write": ["@git:toplevel", "@git:common-dir"],
              // Session env does not reach command sandboxes; repeat git overrides here
              "environment": {
                "set_vars": {
                  "GIT_CONFIG_COUNT": "7",
                  "GIT_CONFIG_KEY_0": "credential.https://github.com.helper",
                  "GIT_CONFIG_VALUE_0": "",
                  "GIT_CONFIG_KEY_1": "credential.https://github.com.helper",
                  "GIT_CONFIG_VALUE_1": "!gh auth git-credential",
                  "GIT_CONFIG_KEY_2": "url.https://github.com/.insteadOf",
                  "GIT_CONFIG_VALUE_2": "git@github.com:",
                  "GIT_CONFIG_KEY_3": "url.https://github.com/.insteadOf",
                  "GIT_CONFIG_VALUE_3": "ssh://git@github.com/",
                  "GNUPGHOME": "/Users/taylorknapp/.gnupg-claude",
                  "GIT_CONFIG_KEY_4": "commit.gpgsign",
                  "GIT_CONFIG_VALUE_4": "true",
                  "GIT_CONFIG_KEY_5": "gpg.program",
                  "GIT_CONFIG_VALUE_5": "gpg",
                  "GIT_CONFIG_KEY_6": "user.signingkey",
                  "GIT_CONFIG_VALUE_6": "9AD1D3F6CB258967"
                }
              },
              "network": {
                "allow_domain": ["github.com", "api.github.com", "codeload.github.com", "objects.githubusercontent.com"]
              }
            },
            "invocation_policy": {
              "default": "deny",
              "deny": [
                { "argv": { "contains": ["--output"] }, "reason": "arbitrary file write" },
                { "argv": { "contains": ["-o"] }, "reason": "arbitrary file write" },
                { "argv": { "contains": ["--exec"] }, "reason": "rebase exec runs code in git sandbox" },
                { "argv": { "contains": ["-x"] }, "reason": "rebase exec runs code in git sandbox" },
                { "argv": { "contains": ["--upload-pack"] }, "reason": "runs code in git sandbox" },
                { "argv": { "contains": ["--receive-pack"] }, "reason": "runs code in git sandbox" },
                { "argv": { "contains": ["--template"] }, "reason": "copies hooks into .git" },
                { "argv": { "prefix": ["remote", "set-url"] }, "reason": "url rewrite" },
                { "argv": { "prefix": ["push"] }, "reason": "mirrors Claude Bash(git push) deny" }
              ],
              "allow": [
                { "argv": { "prefix": ["status"] } },
                { "argv": { "prefix": ["log"] } },
                { "argv": { "prefix": ["diff"] } },
                { "argv": { "prefix": ["show"] } },
                { "argv": { "prefix": ["blame"] } },
                { "argv": { "prefix": ["ls-files"] } },
                { "argv": { "prefix": ["rev-parse"] } },
                { "argv": { "prefix": ["rev-list"] } },
                { "argv": { "prefix": ["merge-base"] } },
                { "argv": { "prefix": ["add"] } },
                { "argv": { "prefix": ["rm"] } },
                { "argv": { "prefix": ["mv"] } },
                { "argv": { "prefix": ["restore"] } },
                { "argv": { "prefix": ["reset"] } },
                { "argv": { "prefix": ["commit"] } },
                { "argv": { "prefix": ["stash"] } },
                { "argv": { "prefix": ["switch"] } },
                { "argv": { "prefix": ["checkout"] } },
                { "argv": { "prefix": ["branch"] } },
                { "argv": { "prefix": ["tag"] } },
                { "argv": { "prefix": ["merge"] } },
                { "argv": { "prefix": ["rebase"] } },
                { "argv": { "prefix": ["cherry-pick"] } },
                { "argv": { "prefix": ["revert"] } },
                { "argv": { "prefix": ["fetch"] } },
                { "argv": { "prefix": ["pull"] } },
                { "argv": { "prefix": ["remote"] } },
                { "argv": { "prefix": ["worktree"] } }
              ]
            }
          }
        }
      },
      "gpg": {
        "executable": "/opt/homebrew/bin/gpg",
        "from": {
          "git": {
            "sandbox": {
              // Inherits git's cwd (repo); getcwd needs read on it
              "fs_read": ["/opt/homebrew", "$HOME/.gnupg-claude", "@git:toplevel"],
              "fs_write": ["$HOME/.gnupg-claude"],
              "unix_socket_bind": ["$HOME/.gnupg-claude/S.gpg-agent"],
              "environment": { "set_vars": { "GNUPGHOME": "/Users/taylorknapp/.gnupg-claude" } }
            },
            "invocation_policy": {
              "default": "deny",
              "allow": [
                { "argv": { "prefix": ["--status-fd=2", "-bsau"] }, "reason": "git commit signing" },
                { "argv": { "contains": ["--verify"] }, "reason": "git signature verification" }
              ]
            }
          },
          "session": {
            "sandbox": {
              "fs_read": [
                "$HOME/.gnupg-claude"
              ],
              "fs_write": [
                "$HOME/.gnupg-claude"
              ],
              "unix_socket_bind": [
                "$HOME/.gnupg-claude/S.gpg-agent"
              ],
              "environment": {
                "set_vars": {
                  "GNUPGHOME": "/Users/taylorknapp/.gnupg-claude"
                }
              }
            },
            "invocation_policy": {
              "default": "deny",
              "allow": [
                {
                  "argv": {
                    "prefix": [
                      "--status-fd=2",
                      "-bsau"
                    ]
                  },
                  "reason": "git commit signing"
                },
                {
                  "argv": {
                    "contains": [
                      "--verify"
                    ]
                  },
                  "reason": "git signature verification"
                }
              ]
            }
          }
        }
      },
      // Only the exact notification scripts from claude/settings.json Stop/Notification hooks
      "osascript": {
        "executable": "/usr/bin/osascript",
        "from": {
          "session": {
            "sandbox": {},
            "invocation_policy": {
              "default": "deny",
              "allow": [
                {
                  "argv": { "exact": ["-e", "display notification \"Response ready\" with title \"Claude Code - Finished\" sound name \"Submarine\""] },
                  "reason": "Stop hook notification"
                },
                {
                  "argv": { "exact": ["-e", "display notification \"Input needed\" with title \"Claude Code - Question\" sound name \"Submarine\""] },
                  "reason": "Notification hook"
                }
              ]
            }
          }
        }
      },
      "security": {
        "executable": "/usr/bin/security",
        "from": { "session": "deny" }
      }
    }
  }
}
