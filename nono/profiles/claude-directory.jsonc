{
  "$schema": "https://raw.githubusercontent.com/nolabs-ai/nono/refs/heads/main/crates/nono/schema/capability-manifest.schema.json",
  "extends": [
    "claude-nokeychain",
    "agent-base"
  ],
  "meta": {
    "name": "claude-directory",
    "description": "Claude Code limited to cwd + agent-base essentials"
  },
  "environment": {
    "set_vars": {
      "CLAUDE_SANDBOX_PROFILE": "claude-directory"
    }
  }
}
