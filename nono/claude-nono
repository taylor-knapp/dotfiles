#!/bin/bash
# Claude Code under nono. Successor to claudie's sandbox/claude-sandboxed.
#   --directory-only  cwd + essentials only (profile claude-directory; no docker, no extra ~/code dirs)
#   --online          allow all outbound domains (still proxied/audited)
#   --login           run `claude auth login` first (standalone profile claude-login: claude + Keychain only), then session
#   --no-omai        skip env from ~/.dotfiles/claude/omai/settings.json (local gateway)
#   --playwright      start a chromium server outside the sandbox, pass PLAYWRIGHT_WS_ENDPOINT in
#   --allow-dir=PATH  grant rw to PATH (nono --allow) + claude --add-dir; repeatable
# Everything else passes through to claude.
set -euo pipefail

NONO_DIR="$(dirname "$(realpath "$0")")"
CT_ROOT="$HOME/code/ct"
PROFILE=claude-sandboxed
NONO_ARGS=(--trust-proxy-ca --allow-cwd)  # proxy CA in keychain -> Go CLIs (gh) trust it
CLAUDE_ARGS=()
USE_OMAI=true PLAYWRIGHT=false LOGIN=false
for a in "$@"; do
  case "$a" in
    --directory-only|--directory) PROFILE=claude-directory ;;
    --online) NONO_ARGS+=(--allow-domain '*') ;;
    --login) LOGIN=true ;;
    --no-omai) USE_OMAI=false ;;
    --playwright) PLAYWRIGHT=true ;;
    --allow-dir=*) d="${a#*=}"; NONO_ARGS+=(--allow "$d"); CLAUDE_ARGS+=(--add-dir "$d") ;;
    *) CLAUDE_ARGS+=("$a") ;;
  esac
done

# Refuse the personal account before any side effects (login, playwright, MCP config).
# Missing login or failed status gives no email, so the check passes.
account="$(claude auth status --json 2>/dev/null | python3 -c 'import json,sys;print(json.load(sys.stdin).get("email") or "")' 2>/dev/null || true)"
if [ "$account" = "taylor.r.knapp@gmail.com" ]; then
  echo "[claude-nono] refusing to run as $account (claude auth status --json); log out or switch accounts first" >&2
  exit 1
fi

# Commit signing reaches gpg-agent through the sandbox socket in ~/.gnupg-claude (agent-base git.session env).
# The agent runs outside the sandbox, so start it here; gpgconf --launch is a no-op when it is already up.
GNUPGHOME="$HOME/.gnupg-claude" gpgconf --launch gpg-agent

# localhost port from a URL (gateway / playwright ws endpoint)
url_port() { python3 -c 'import sys,urllib.parse as u;print(u.urlparse(sys.argv[1]).port or "")' "$1"; }

# omai: pass settings.json as --settings (session-only env: gateway URL/token/models).
OMAI="$HOME/.dotfiles/claude/omai/settings.json"
OMAI_ARGS=()
if [ "$USE_OMAI" = true ] && [ -s "$OMAI" ]; then
  export ANTHROPIC_AUTH_TOKEN="ignored"
  OMAI_ARGS=(--settings "$OMAI")
  url="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["env"]["ANTHROPIC_BASE_URL"])' "$OMAI")"
  port="$(url_port "$url")"
  [ -n "$port" ] && NONO_ARGS+=(--open-port "$port")
fi

# AG MCP client secrets: base64(client_id:secret) per keystore account (service nono), exported as AG_<ACCOUNT>_SECRET.
# Not in the mcp profile: env_credentials turn into phantoms once agent-base has any command_policies entry (see nono/AGENTS.md).
# A missing item only skips that AG server; mcp-wrapper-ag.sh then fails with its own error.
for acct in ag_tk_1 ag_tk_all ag_nico_test_project_tk_all ag_audit_log_aws_test_tk_all; do
  secret="$(security find-generic-password -s nono -a "$acct" -w 2>/dev/null || true)"
  if [ -z "$secret" ]; then
    echo "[claude-nono] keystore item nono/$acct not found; its AG MCP server will fail" >&2
    continue
  fi
  export "$(printf '%s' "$acct" | tr 'a-z' 'A-Z')_SECRET=$secret"
done

# Separate standalone login sandbox (claude install, ~/.claude, Keychain, claude hosts,
# callback listener, browser open) runs `claude auth login`; no cwd, no agent-base.
# Login lands in host Keychain; later sessions' oauth_capture store reads it host-side.
if [ "$LOGIN" = true ]; then
  nono -s run -p claude-login --allow-launch-services --trust-proxy-ca -- claude auth login
  # Because we don't allow the regular sandbox profile access to the Keychain, we must export the credentials to a file that claude uses for storage if it doesn't have keychain access.
  # These values are actually the phantoms produced by nono, and the real values are stored in local nono state, ~/.local/state/nono/oauth-capture/providers.json.
  security find-generic-password -s "Claude Code-credentials" -w > ~/.claude/.credentials.json
fi

# Per-repo grants (profile globs like $HOME/code/*-worktrees hang nono 0.79).
# main = repo owning the shared .git, so this also works from inside a worktree.
if common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
  main="$(dirname "$common")"
  [ -d "$main-worktrees" ] && NONO_ARGS+=(--allow "$main-worktrees")
  [ "$main" != "$(git rev-parse --show-toplevel)" ] && NONO_ARGS+=(--allow "$main")  # in a worktree
  case "$main/" in "$CT_ROOT"/*) NONO_ARGS+=(--read "$CT_ROOT") ;; esac
fi

# Playwright server runs OUTSIDE the sandbox (full network); claude connects via ws on localhost.
if [ "$PLAYWRIGHT" = true ]; then
  PW_BIN="${CLAUDE_PLAYWRIGHT_BIN:-$(command -v playwright || true)}"
  [ -x "$PW_BIN" ] || { echo "[claude-nono] playwright not found at $PW_BIN (set CLAUDE_PLAYWRIGHT_BIN)" >&2; exit 1; }
  mkdir -p /tmp/claude
  PW_LOG="/tmp/claude/playwright-$$.log"
  "$PW_BIN" launch-server --browser chromium >"$PW_LOG" 2>&1 &
  PW_PID=$!
  trap 'kill "$PW_PID" 2>/dev/null || true' EXIT
  PLAYWRIGHT_WS_ENDPOINT=""
  for _ in $(seq 1 100); do
    PLAYWRIGHT_WS_ENDPOINT="$(grep -oE 'ws://[^[:space:]]+' "$PW_LOG" 2>/dev/null | head -1 || true)"
    [ -n "$PLAYWRIGHT_WS_ENDPOINT" ] && break
    kill -0 "$PW_PID" 2>/dev/null || break
    sleep 0.1
  done
  if [ -z "$PLAYWRIGHT_WS_ENDPOINT" ]; then
    echo "[claude-nono] playwright server gave no ws endpoint within 10s (first run: $PW_BIN install chromium)" >&2
    cat "$PW_LOG" >&2
    exit 1
  fi
  export PLAYWRIGHT_WS_ENDPOINT
  NONO_ARGS+=(--open-port "$(url_port "$PLAYWRIGHT_WS_ENDPOINT")")
  echo "[claude-nono] Playwright server: $PLAYWRIGHT_WS_ENDPOINT" >&2
fi

# MCP servers off by default for this project; must run before claude reads ~/.claude.json.
printf '{"cwd":%s}' "$(python3 -c 'import json,os;print(json.dumps(os.getcwd()))')" \
  | bash "$NONO_DIR/disable-all-mcp.sh" || true

# GitHub token for this repo's owner (custom_credentials in agent-base); none for other owners.
owner="$(git remote get-url origin 2>/dev/null | sed -E 's#.*github.com[:/]([^/]+)/.*#\1#' || true)"
case "$owner" in
  commercetools) NONO_ARGS+=(--credential github_commercetools) ;;
  taylor-knapp)  NONO_ARGS+=(--credential github_personal) ;;
esac

# Repo-local .nono.json (repo root, else cwd) layers on top of $PROFILE.
LOCAL="$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.nono.json"
if [ -f "$LOCAL" ]; then
  NONO_ARGS+=(--extends "$PROFILE")
  PROFILE="$LOCAL"
  echo "[claude-nono] Local profile: $LOCAL" >&2
fi

# Not exec'd: EXIT trap must stop the playwright server.
nono run -p "$PROFILE" "${NONO_ARGS[@]}" -- claude --permission-mode auto ${OMAI_ARGS[@]+"${OMAI_ARGS[@]}"} ${CLAUDE_ARGS[@]+"${CLAUDE_ARGS[@]}"}
