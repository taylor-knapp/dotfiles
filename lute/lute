#!/bin/sh
#
# Start Lute and open it in the browser.
# Data lives in iCloud Drive so it syncs between machines. Override with LUTE_DATA.
# Run Lute on one machine at a time: SQLite does not handle concurrent writers.

set -e
DIR="$(dirname "$(realpath "$0")")"
PORT="${LUTE_PORT:-5001}"
DATA="${LUTE_DATA:-$HOME/Library/Mobile Documents/com~apple~CloudDocs/lute}"
URL="http://localhost:$PORT"

[ -x "$DIR/.venv/bin/python" ] || "$DIR/install.sh"

if curl -s -o /dev/null "$URL"; then
  open "$URL"
  exit 0
fi

# Offline dictionaries for Lute, one server per file (see dictserver.py).
# In Lute: URI http://localhost:<port>/[LUTE], type Embedded.
# Servers started here are stopped when Lute exits.
DICTS="$HOME/Documents/Dictionaries"
"$DIR/dicts.sh" "$DICTS" || echo "Dictionary download failed; continuing without it." >&2
PIDS=""
trap 'kill $PIDS 2>/dev/null' EXIT
trap 'exit 130' INT TERM HUP
# Not 8765: oktapus listens there. A busy port fails loudly ("Address already in use").
for d in "dict-fr-en.df 8767" "dict-fr-fr.df 8766"; do
  set -- $d
  "$DIR/.venv/bin/python" "$DIR/dictserver.py" "$DICTS/$1" "$2" &
  PIDS="$PIDS $!"
done

mkdir -p "$DATA/backups"
cat > "$DIR/.venv/config.yml" <<YML
ENV: prod
DBNAME: lute.db
DATAPATH: $DATA
BACKUP_PATH: $DATA/backups
YML

(sleep 3 && open "$URL") &
"$DIR/.venv/bin/python" -m lute.main --port "$PORT" --config "$DIR/.venv/config.yml"
