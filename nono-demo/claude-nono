#!/bin/bash
# Start Claude Code sandboxed by nono. All arguments pass through to claude.

set -euo pipefail

# Set the current directory to the script's location, so that relative paths work.
NONO_DIR="$(dirname "$(realpath "$0")")"

# Load machine-specific paths (CT_ROOT, OMAI_SETTINGS) from .env. Copy .env.template to start.
[ -f "$NONO_DIR/.env" ] || { echo "missing $NONO_DIR/.env (copy .env.template)" >&2; exit 1; }
set -a; . "$NONO_DIR/.env"; set +a

NONO_ARGS=(--trust-proxy-ca --allow-cwd --credential github)  # proxy CA in keychain -> Go CLIs (gh) trust it

#### REQUIRES SETUP ####
# Export the github token, which nono will inject into any github requests.
export GITHUB_TOKEN="$(security find-generic-password -s nono -a github_commercetools -w 2>/dev/null || true)"

#### REQUIRES SETUP ####
# Commit signing reaches gpg-agent through the sandbox socket in ~/.gnupg-claude (agent-base git.session env).
# The agent runs outside the sandbox, so start it here; gpgconf --launch is a no-op when it is already up.
GNUPGHOME="$HOME/.gnupg-claude" gpgconf --launch gpg-agent

###
# OMAI settings are merged with claude settings via the --settings flag.
# However, we need to tell nono (a) auth is handled via a token and (b) to open the port for the gateway URL.
# (if we don't set the dummy token, nono automatiacally enables --allow-launch-services, which we don't want)
###
export ANTHROPIC_AUTH_TOKEN="ignored"
AGATHA_PROXY_PORT="$(grep ANTHROPIC_BASE_URL "$OMAI_SETTINGS" | grep -oE ':[0-9]+' | tr -d ':')"


###
# To facilitate cross-worktree and other ct repo access, we do the following here:
# 1. If the current directory is inside a git repo, find the main repo (the one with the shared .git dir).
# 2. If the main repo has a worktrees dir, grant nono read access.
# 3. If the current directory is a worktree, grant nono read access to the main repo.
# 4. If the main repo is inside $CT_ROOT, grant nono read access to $CT_ROOT.
###
if common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
  main="$(dirname "$common")"
  [ -d "$main-worktrees" ] && NONO_ARGS+=(--allow "$main-worktrees")
  [ "$main" != "$(git rev-parse --show-toplevel)" ] && NONO_ARGS+=(--allow "$main")  # in a worktree
  case "$main/" in "$CT_ROOT"/*) NONO_ARGS+=(--read "$CT_ROOT") ;; esac
fi

exec nono run -p claude-code \
  --trust-proxy-ca \
  --allow-cwd \
  --credential github \
  --open-port $AGATHA_PROXY_PORT -- \
  claude --permission-mode auto --settings "$OMAI_SETTINGS" "$@"
