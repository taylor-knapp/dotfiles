{
  "$schema": "../profile.schema.json",
  "meta": {
    "name": "commercetools",
    "description": "commercetools specific setup: Zscaler CA and GitHub credential"
  },
  "filesystem": {
    // Zscaler root CA for TLS inspection. Setup steps: TODO, export the root CA to this path.
    "read": [
      "$HOME/.certs/zscaler-root-ca.pem"
    ]
  },
  "environment": {
    "set_vars": {
      "NODE_EXTRA_CA_CERTS": "$HOME/.certs/zscaler-root-ca.pem" 
    }
  },
  "network": {
    // Fine-grained GitHub PAT for commercetools repos. claude-nono enables it per session
    // (--credential) from the origin remote's owner. The real token lives in Keychain (service
    // "nono", account = credential_key); the sandbox sees only a phantom GH_TOKEN.
    "custom_credentials": {
      "github_commercetools": {
        "upstream": "https://api.github.com",
        "credential_key": "github_commercetools",
        "env_var": "GH_TOKEN",
        "inject_header": "Authorization",
        "credential_format": "token {}"
      }
    }
  }
}
