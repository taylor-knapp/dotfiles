{
  "$schema": "../profile.schema.json",
  "meta": {
    "name": "commercetools",
    "description": "commercetools specific setup: Zscaler CA and GitHub credential"
  },
  "allow_launch_services": false,
  "open_urls": {
    // Allow commercetools auth endpoints for OAuth token capture when logging into mcps.
    "allow_origins": [
      "https://auth2.europe-west1.gcp.commercetools.com",
      "https://auth2.eu-central-1.aws.commercetools.com",
      "https://mcp.atlassian.com"
    ],
    "allow_localhost": false
  },
  "filesystem": {
    // Zscaler root CA for TLS inspection. Export the value from keychain.
    // > security find-certificate -a -p -c "Zscaler Root CA" > ~/.certs/zscaler-root-ca.pem
    "read": [
      "$HOME/.certs/zscaler-root-ca.pem"
    ],
    // pnpm reads this file in place of ~/.npmrc (see NPM_CONFIG_USERCONFIG). It holds no secret.
    "read_file": [
      "$HOME/.nono.npmrc"
    ]
  },
  // Supervisor-side token for the custom credential below. Runs outside the sandbox.
  // Cached 30 min: Google access tokens last 1 hour.
  "credential_capture": {
    "gcp_npm": {
      "command": ["$HOME/bin/nono-gcp-npm-token-helper"],
      "timeout_secs": 30,
      "ttl_secs": 1800
    }
  },
  "network": {
    // Artifact Registry npm (commercetools internal packages).
    // Proxy swaps the phantom token in GCP_NPM_PHANTOM for the gcloud token on europe-npm.pkg.dev requests.
    "credentials": ["gcp_npm"],
    "custom_credentials": {
      "gcp_npm": {
        "upstream": "https://europe-npm.pkg.dev",
        "credential_key": "cmd://gcp_npm",
        "env_var": "GCP_NPM_PHANTOM",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      }
    },
    "allow_domain": [
      "europe-npm.pkg.dev"
    ]
  },
  "environment": {
    "allow_vars": [
      "GCP_NPM_PHANTOM"
    ],
    "set_vars": {
      "NODE_EXTRA_CA_CERTS": "$HOME/.certs/zscaler-root-ca.pem",
      // Points pnpm at the sandbox npmrc, so the real ~/.npmrc (denied in the sandbox) is not read.
      "NPM_CONFIG_USERCONFIG": "$HOME/.nono.npmrc"
    }
  }
}
