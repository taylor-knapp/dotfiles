{
  "$schema": "../profile.schema.json",
  "meta": {
    "name": "commercetools",
    "description": "commercetools specific setup: Zscaler CA and GitHub credential"
  },
  "allow_launch_services": false,
  "open_urls": {
    // Allow commercetools auth endpoints for OAuth token capture when logging into mcps.
    "allow_origins": [
      "https://auth2.europe-west1.gcp.commercetools.com",
      "https://auth2.eu-central-1.aws.commercetools.com"
    ],
    "allow_localhost": false
  },
  "filesystem": {
    // Zscaler root CA for TLS inspection. Export the value from keychain.
    // > security find-certificate -a -p -c "Zscaler Root CA" > ~/.certs/zscaler-root-ca.pem
    "read": [
      "$HOME/.certs/zscaler-root-ca.pem"
    ]
  },
  "environment": {
    "set_vars": {
      "NODE_EXTRA_CA_CERTS": "$HOME/.certs/zscaler-root-ca.pem" 
    }
  }
}
