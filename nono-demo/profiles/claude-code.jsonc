{
  "$schema": "../profile.schema.json",
  // Later extensions override earlier onces, so the order here matters.
  "extends": ["nolabs-ai-claude", "base", "commercetools", "personal"],
  "meta": {
    "name": "claude-code",
    "description": "Claude Code sandboxed profile."
  },
  "filesystem": {
    "allow": [
      "/tmp/claude"
    ]
    // Disabled. Enable once the setup steps for $HOME/.gnupg-claude are written down.
    // "deny": [
    //   "$HOME/.gnupg-claude"
    // ]
  }
}
